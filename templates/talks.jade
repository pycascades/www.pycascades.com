extends "base.jade"

block page_title
    |{{ this.title }} &mdash; {{super()}}

block body_class
    |talks
    |talk-list

block main

    .container
        {{ this.description.html }}
        {% set speakers = site.query("/speakers").include_undiscoverable(true) %}

        .item-list
            {% for talk in site.query('/talks') %}
            {% for speaker_slug in talk.speakers %}

            {% set speaker = speakers.filter(F._slug == speaker_slug).first() %}
            {% set headshot = speaker.attachments.get('headshot.jpg') %}
            {% set thumbnail = speaker.attachments.get('headshot-sm.jpg') %}
            .item
                a(href="{{ talk|url }}")
                    {% if thumbnail %}
                    .headshot.image.bg-contain(
                        ff-bg="{{ thumbnail.path }}",
                        ff-bg-2x="{{ thumbnail.path }}",
                    )
                    {% elif speaker.twitter %}
                    .headshot.image.bg-contain(
                        ff-bg="https://avatars.io/twitter/{{speaker.twitter}}/medium",
                        ff-bg-2x="https://avatars.io/twitter/{{speaker.twitter}}/original",
                    )
                    {% else %}
                    .headshot.image.bg-contain(
                        ff-bg="/static/images/headshot.png",
                        ff-bg-2x="/static/images/headshot.png",
                    )
                    {% endif %}

                    h3 {{ talk.title }}

                    .byline {{ speaker.name }}
            {% endfor %}
            {% endfor %}
