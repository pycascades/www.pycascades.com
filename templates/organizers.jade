extends "base.jade"

block page_title
    |{{ this.title }} &mdash; {{super()}}

block body_class
    |about
    |organizers

block main

    .container

        h1 {{ this.title }}

        p.
            {{ this.description.html }}

        .item-list

            {% set organizers = site.query('/organizers').include_undiscoverable(True) %}
            {% for organizer in organizers.filter(F.section == 'chair') %}
            {% include "includes/organizer.jade" %}
            {% endfor %}

        .item-list

            {% for organizer in organizers.filter(F.section == 'organizer') %}
            {% include "includes/organizer.jade" %}
            {% endfor %}

        .item-list

            {% for organizer in organizers.filter(F.section == 'emeritus') %}
            {% include "includes/organizer.jade" %}
            {% endfor %}
