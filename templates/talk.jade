extends "base.jade"

block page_title
    |{{ this.title }} &mdash; {{super()}}

block meta_description
    |{{super()}} {{ this.title }}

block body_class
    |talks
    |talk-detail

block main

    .container
        {% set speakers = site.query("/speakers").include_undiscoverable(true) %}

        h1 {{ this.title }}
        .byline
            {% for speaker_slug in this.speakers %}
            {% set speaker = speakers.filter(F._slug == speaker_slug).first() %}
            {{ speaker.name }}
            {% if not loop.last %} &amp; {% endif %}
            {% endfor %}
        .abstract
            p {{ this.abstract.html }}

        {% if this.slides %}
        .slides
            a.ext(href="{{ this.slides }}", target="_blank") Slides
        {% endif %}

        {% if this.video %}
        .video
            a.ext(href="{{ this.video }}", target="_blank") Video
        {% endif %}

    {% for speaker_slug in this.speakers %}
    {% set speaker = speakers.filter(F._slug == speaker_slug).first() %}
    .container
        {% set headshot = speaker.attachments.get('headshot.jpg') %}
        {% if headshot %}
        .headshot.image.bg-contain(
            ff-bg="{{ headshot.thumbnail(200)|url }}",
            ff-bg-2x="{{ headshot.thumbnail(400)|url }}"
        )
        {% else %}
        .headshot.image.bg-contain(
            ff-bg="/static/images/headshot.png",
            ff-bg-2x="/static/images/headshot.png",
        )
        {% endif %}

        h2 About {{ speaker.name }}
        .biography
            {{ speaker.bio.html }}
        .contact
            {% if speaker.website %}
            .url
                a(href="{{ speaker.website }}", target="_blank").
                    #[i.fa.fa-external-link] {{ speaker.website }}
            {% endif %}
            {% if speaker.twitter %}
            .twitter
                a(
                    href="https://www.twitter.com/{{ speaker.twitter }}",
                    target="_blank"
                ).
                    #[i.fa.fa-twitter] {{ speaker.twitter }}
            {% endif %}
            {% if speaker.instagram %}
            .instagram
                a(
                    href="https://www.instagram.com/{{ speaker.instagram }}",
                    target="_blank"
                ).
                    #[i.fa.fa-instagram] {{ this.instagram }}
            {% endif %}
            {% if this.github %}
            .github
                a(
                    href="https://www.github.com/{{ speaker.github }}",
                    target="_blank"
                ).
                    #[i.fa.fa-github] {{ this.github }}
            {% endif %}
    {% endfor %}

    .more
        a(href="{{ '/talks'|url }}") More Talks
