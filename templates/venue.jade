extends "base.jade"

block page_title
    |{{this.title}}  &mdash; {{super()}}

block body_class
    |venue

block main

    section#intro
        .background(du-parallax, y="animator")
            .image.bg-cover(ff-bg="{{ this.background }}")
        .overlay
        .main.vcontainer
            .inner
                .container
                    .row.fade-up(in-view)
                        .one-half.column
                            h2 {{ this.title }}
                        .one-half.column
                            {{ this.body.html }}

                            .image-credit
                                {{ this.credit.html }}
        a.down(ng-click="scrollTo('accommodations')")
            {% include "includes/chevron-down.svg" %}

    section#location
        .main.vcontainer#map

    section#accommodations
        .background(du-parallax, y="animator")
            .image.bg-cover(ff-bg="/static/images/hotel_bed.jpg")
        .overlay
        .main.vcontainer
            .inner
                .container
                    .row.fade-up(in-view)
                        .one-half.column
                            h2 Accommodation
                        .one-half.column
                            |Portland is filled with a variety of options for accommodation ranging from the traditional hotel experience, boutique hotels all the way to the more personal #[a(href="https://www.airbnb.ca/s/Portland--OR--United-States/homes") Airbnb stays]. <br>The downtown area is easily reached by #[a(href="http://trimet.org/schedules/r015.htm") public transit using bus route 15] crossing Morrison Bridge or by using one of the ridesharing apps. You can even take one of the #[a(href="https://www.biketownpdx.com/") biketown bikes] across if you feel more adventurous.
        a.down(ng-click="scrollTo('hotels')")
            {% include "includes/chevron-down.svg" %}

    {% set hotels = site.query('/hotels').include_undiscoverable(True) %}
    section#hotels
        .background(du-parallax, y="animator")
            .image.bg-cover(ff-bg="/static/images/bedroom_door.jpg")
        .overlay
        .main.vcontainer
            .inner
                .container
                    HOTELS {{ hotels }}
                    .row.fade-up(in-view)
                        {% for hotel in hotels %}
                        .one-third.column
                            h3 {{ hotel.name }}
                            p  {{ hotel.description }}
                            a(href="{{ hotel.website }}") Find out more &hellip;
                        {% endfor %}

append bottom
    link(
        rel="stylesheet",
        href="https://unpkg.com/leaflet@1.3.4/dist/leaflet.css"
        integrity="sha512-puBpdR0798OZvTTbP4A8Ix/l+A4dHDD0DGqYW6RQ+9jxkRFclaxxQb/SJAWZfWAkuyeQUytO7+7N4QKrDh+drA=="
        crossorigin=""
    )

    script(
        src="https://unpkg.com/leaflet@1.3.4/dist/leaflet.js"
        integrity="sha512-nMMmRyTVoLYqjP9hrbed9S+FzjZHW5gY1TWCHA5ckwXZBadntCNs8kEqAWdrb9O7rxbCaA4lKTIWjDXZxflOcA=="
        crossorigin=""
    )

    script.
        var revHallCoordinates = [45.5191784,-122.654018];
        var map = L.map(
            'map', {
                scrollWheelZoom: false,
            }
        ).setView(revHallCoordinates, 16);
        mapLink =
            '<a href="http://openstreetmap.org">OpenStreetMap</a>';

        L.tileLayer('https://stamen-tiles-{s}.a.ssl.fastly.net/toner-lite/{z}/{x}/{y}{r}.{ext}', {
            attribution: 'Map tiles by <a href="http://stamen.com">Stamen Design</a>, <a href="http://creativecommons.org/licenses/by/3.0">CC BY 3.0</a> &mdash; Map data &copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>',
            subdomains: 'abcd',
            minZoom: 0,
            maxZoom: 20,
            ext: 'png'
        }).addTo(map);

        var revHall = L.marker(revHallCoordinates).bindPopup(
            '<h3>Revolution Hall</h3>' +
            '1300 SE Stark Street<br>' +
            'Portland, OR<br><br>' +
            '<a style="color: black" href="https://goo.gl/maps/cjPamvurMyYEKwig7">View on Google Maps</a>'
        ).addTo(map);
        revHall.openPopup();
